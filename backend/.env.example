# ── Google AI ────────────────────────────────────────────────────────────────
# Your Google Gemini API key. Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Gemini model to use. Recommended: gemini-2.0-flash (fast) or gemini-1.5-pro (capable)
GEMINI_MODEL=gemini-2.0-flash

# ── Agent Mode ───────────────────────────────────────────────────────────────
# 'gemini' — real Gemini API calls (requires GOOGLE_API_KEY)
# 'mock'   — deterministic mock responses (no API key needed, great for dev/testing)
AGENT_MODE=mock

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for local development. Replace with Cloud SQL or Firestore URL for production.
DATABASE_URL=sqlite:///./app.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── App ──────────────────────────────────────────────────────────────────────
# Set DEBUG=true to enable verbose SQL and request logging
DEBUG=false
